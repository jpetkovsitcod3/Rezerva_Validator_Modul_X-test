# ========================================================================
# Docker Compose Override for Production with Upstash Redis
# ========================================================================
# Usage: cp docker-compose.override.yml.example docker-compose.override.yml
# Then edit with your actual Upstash credentials
# ========================================================================

services:
  api:
    environment:
      # Upstash Redis (TLS enabled - use rediss://)
      - REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_ENDPOINT.upstash.io:6379/0
      - CELERY_BROKER_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_ENDPOINT.upstash.io:6379/1
      - CELERY_RESULT_BACKEND=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_ENDPOINT.upstash.io:6379/2
      - DEBUG=false
      # Production CORS - replace with your domain
      - CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
    # Remove volume mount for production
    volumes: []
    # Use production command (no reload, more workers)
    command: >
      gunicorn app.main:app
        --workers 4
        --worker-class uvicorn.workers.UvicornWorker
        --bind 0.0.0.0:8000
        --timeout 120
        --access-logfile -
        --error-logfile -

  worker:
    environment:
      - REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_ENDPOINT.upstash.io:6379/0
      - CELERY_BROKER_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_ENDPOINT.upstash.io:6379/1
      - CELERY_RESULT_BACKEND=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_ENDPOINT.upstash.io:6379/2
    volumes: []
    command: >
      celery -A app.tasks.celery_tasks.celery_app
        worker --loglevel=info --concurrency=8

  frontend:
    environment:
      # Set to your production API URL
      - VITE_API_URL=https://api.yourdomain.com
    volumes: []
    command: sh -c "npm install && npm run build && npx serve -s dist -l 5173"

  # Redis service REMOVED - using Upstash instead
  # redis:  (commented out)

volumes:
  # redis_data:  (commented out - not needed with Upstash)