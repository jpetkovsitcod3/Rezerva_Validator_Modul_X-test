# Copy to .env and adjust for your environment
APP_NAME="EmailValidator Pro"
APP_VERSION="2.0.0"
DEBUG=true
SECRET_KEY=change-me-in-production
HOST=0.0.0.0
PORT=8000
WORKERS=4
# --- Supabase (Postgres + PostgREST) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key   # safe for browser (RLS governs access)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # server-only, bypasses RLS
ENABLE_DB_PERSISTENCE=true

# Local dev DB fallback (not used when Supabase is configured)
DATABASE_URL=sqlite+aiosqlite:///./emailval.db
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=86400
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
SMTP_TIMEOUT=10
DNS_TIMEOUT=5
MAX_BULK_EMAILS=10000
RATE_LIMIT_PER_MINUTE=60
USE_PROXIES=false
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
