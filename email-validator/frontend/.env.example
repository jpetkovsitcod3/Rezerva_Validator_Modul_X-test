# Frontend environment (optional — sane defaults work with the Vite dev proxy)
# Leave VITE_API_URL empty in development: Vite proxies /api -> http://localhost:8000
VITE_API_URL=
# If the backend runs elsewhere (e.g. a deployed API), set it explicitly:
# VITE_API_URL=https://your-api.example.com

# Supabase keys for future direct-browser usage (optional)
# The publishable / anon key is safe in the browser ONLY when RLS is enabled
# (see supabase/schema.sql). The backend uses the service_role key instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=